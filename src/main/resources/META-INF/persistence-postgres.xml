<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                  https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="hub-metrics-persistence-unit">
        <class>de.htwberlin.model.ConnectionRequest</class>
        <class>de.htwberlin.model.Register</class>
        <class>de.htwberlin.model.StartDataSession</class>
        <class>de.htwberlin.model.Unregister</class>
        <class>de.htwberlin.model.Session</class>
        <class>de.htwberlin.model.Disconnect</class>
        <class>de.htwberlin.model.NotifyConnectionEnded</class>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/hub_metrics"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="hub"/>
            <property name="jakarta.persistence.jdbc.password" value="hub"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.transaction.coordinator_class" value="jdbc"/>
        </properties>
    </persistence-unit>
</persistence>
